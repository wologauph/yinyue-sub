{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "yinyue-sub",
  "main": "cloudflare/src/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sub-store-cloudflare",
      "database_id": "b23aca49-d829-4456-a158-2d60d68c0e98",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "SUB_STORE_APP_NAME": "Sub-Store Cloudflare",
    "SUB_STORE_PUBLIC_DOWNLOAD_HOSTS": "none",
    "SUB_STORE_ADMIN_TOKEN": "2m-STWlD3_xIBtedsaxVpnW_imQYpIq7XAmXj9pK3rw",
    "SUB_STORE_PUBLIC_DOWNLOAD_TOKEN": "lQTnW_AMOpmalIQBHX9Keo6fpNnnsUBJzdL2r2D2Hgo"
  }
}
